# net-shell-32 sdkconfig.defaults
#
# Every non-default Kconfig setting this feature relies on must be
# reproducible from this file (sdkconfig itself is gitignored). See
# tech_spec.md §6.3 for the full justification and source citations for
# each value below.

# --- target (HW-1) ---
CONFIG_IDF_TARGET="esp32"

# --- console transport (HW-4, HW-5) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- byte-exact prompt and plain-ASCII output (FR-13, NFR-6, NFR-7) ---
# v6.0.2 already defaults LOG_COLORS to n; pinned so a menuconfig flip cannot
# silently wrap the prompt in ANSI codes (see V6-3).
CONFIG_LOG_COLORS=n

# --- keep esp_log_level_set() effective at runtime (OQ-11 / §8.6) ---
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# =====================================================================
# NETSHELL32-2: BLE OTA firmware update with rollback and pairing
# See .claude/workitem/NETSHELL32-2/tech_spec.md for full justification.
# =====================================================================

# --- flash size: 4 MB confirmed target hardware (HW-6); replaces the
# stale 2MB assumption from NETSHELL32-1 ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- partition table: dual-OTA custom layout (BLD-2). Filename already
# defaults to "partitions.csv"; CONFIG_PARTITION_TABLE_CUSTOM itself was
# the missing piece flagged by BLD-2's inconsistency note. ---
CONFIG_PARTITION_TABLE_CUSTOM=y

# --- bootloader app-rollback support: freshly written images boot
# PENDING_VERIFY rather than being trusted immediately (BLD-3, FR-801,
# FR-802). CONFIG_APP_ROLLBACK_ENABLE is auto-selected by this option. ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# --- Bluetooth: BLE-only via NimBLE (BLD-4, HW-5 resolved to NimBLE,
# tech_spec.md §2.2). ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- single concurrent OTA client only (FR-206); belt-and-braces on top
# of the runtime connection-count check. ---
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# --- bond store persisted in NVS so bonds survive an OTA reboot
# (FR-304, OQ-4), with a bounded/documented capacity (FR-304). ---
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4

# =====================================================================
# NETSHELL32-5: BLE UART CLI, device diagnostics and ADXL345 support
# See workitem/NETSHELL32-5-ble-uart-cli-adxl345/tech_spec.md section 2.12.
# =====================================================================

# --- radio pinned even where equal to the IDF default (REQ-BLD-03) ---
# BLE-only controller
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# Wi-Fi/BT software coexistence (REQ-HW-09)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Controller connection slots match CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1 (about 1 KiB static DRAM each)
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
# NimBLE host task is now always on; size pinned, to be resized from STACK_HWM (REQ-MEM-04)
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# --- security: SC pairing compiled in (OQ-03); the app handles REPEAT_PAIRING
# itself (REQ-FUNC-80(b)) ---
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=n

# --- firmware version comes only from version.txt (REQ-FUNC-24) ---
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n
CONFIG_APP_EXCLUDE_PROJECT_VER_VAR=n

# --- ble_host_start() (nimble_port_init + GATT registration) now runs on the
# main task after the REPL starts (ADV-BOOT-14); NETSHELL32-2 ran it on the
# 8 KiB REPL task. Transient: the main task stack is freed when app_main()
# returns, so there is no steady-state cost. ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# --- I2C master ISR stays in flash: IRAM headroom is only 8,961 B (baseline
# (c)) and the ISR is not IRAM-safe anyway (I2C_ISR_IRAM_SAFE=n), so IRAM
# placement buys nothing (ADV-NEW-04) ---
CONFIG_I2C_ISR_IRAM_SAFE=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
