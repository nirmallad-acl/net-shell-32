# net-shell-32 sdkconfig.defaults
#
# Every non-default Kconfig setting this feature relies on must be
# reproducible from this file (sdkconfig itself is gitignored). See
# tech_spec.md §6.3 for the full justification and source citations for
# each value below.

# --- target (HW-1) ---
CONFIG_IDF_TARGET="esp32"

# --- console transport (HW-4, HW-5) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- byte-exact prompt and plain-ASCII output (FR-13, NFR-6, NFR-7) ---
# v6.0.2 already defaults LOG_COLORS to n; pinned so a menuconfig flip cannot
# silently wrap the prompt in ANSI codes (see V6-3).
CONFIG_LOG_COLORS=n

# --- keep esp_log_level_set() effective at runtime (OQ-11 / §8.6) ---
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# =====================================================================
# NETSHELL32-2: BLE OTA firmware update with rollback and pairing
# See .claude/workitem/NETSHELL32-2/tech_spec.md for full justification.
# =====================================================================

# --- flash size: 4 MB confirmed target hardware (HW-6); replaces the
# stale 2MB assumption from NETSHELL32-1 ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- partition table: dual-OTA custom layout (BLD-2). Filename already
# defaults to "partitions.csv"; CONFIG_PARTITION_TABLE_CUSTOM itself was
# the missing piece flagged by BLD-2's inconsistency note. ---
CONFIG_PARTITION_TABLE_CUSTOM=y

# --- bootloader app-rollback support: freshly written images boot
# PENDING_VERIFY rather than being trusted immediately (BLD-3, FR-801,
# FR-802). CONFIG_APP_ROLLBACK_ENABLE is auto-selected by this option. ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# --- Bluetooth: BLE-only via NimBLE (BLD-4, HW-5 resolved to NimBLE,
# tech_spec.md §2.2). ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- single concurrent OTA client only (FR-206); belt-and-braces on top
# of the runtime connection-count check. ---
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# --- bond store persisted in NVS so bonds survive an OTA reboot
# (FR-304, OQ-4), with a bounded/documented capacity (FR-304). ---
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
