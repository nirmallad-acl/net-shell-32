menu "Accelerometer (ADXL345 + simulator)"

    config ACCEL_I2C_PORT
        int "I2C controller number"
        range 0 1
        default 0
        help
            REQ-HW-03. The ESP32 has two I2C controllers; the sensor uses
            this one in master mode.

    config ACCEL_I2C_SDA_GPIO
        int "I2C SDA GPIO"
        range 0 33
        default 21
        help
            REQ-HW-03. Compile-time checked by a C _Static_assert in
            accel_bus_i2c.c (not by CMake; Kconfig cannot exclude values from a
            range): never UART0 (GPIO 1, 3), never the SPI flash pins (6..11),
            never the strapping pins (0, 2, 5, 12, 15) and never an input-only
            pin. DevKit-C v1 pin 21 is the standard I2C SDA.

    config ACCEL_I2C_SCL_GPIO
        int "I2C SCL GPIO"
        range 0 33
        default 22
        help
            REQ-HW-03. Same checks as ACCEL_I2C_SDA_GPIO.

    config ACCEL_I2C_FREQ_HZ
        int "I2C clock frequency (Hz)"
        range 100000 400000
        default 100000
        help
            100 kHz standard mode (the internal pull-ups are weak, so do not
            raise this without strong external pull-ups).

    config ACCEL_I2C_TIMEOUT_MS
        int "Per-transaction I2C timeout (ms)"
        range 10 100
        default 50
        help
            REQ-FUNC-52. Every transaction passes this finite timeout;
            -1 (wait forever) is never used.

    config ACCEL_PROBE_INTERVAL_MS
        int "Sensor re-probe interval while no sensor is active (ms)"
        range 1000 60000
        default 5000
        help
            OQ-07. The probe task runs one cycle this often while the state
            is not ACTIVE.

    config ACCEL_FAIL_THRESHOLD
        int "Consecutive read failures before falling back to the simulator"
        range 1 10
        default 3
        help
            OQ-07, REQ-FUNC-58.

    config ACCEL_MAX_AGE_MS
        int "Maximum age of a hardware sample at reporting time (ms)"
        range 10 1000
        default 100
        help
            OQ-06, REQ-FUNC-56. A hardware sample older than this is
            reported as ERR sensor_stale; an age exactly at the limit is
            accepted.

    config ACCEL_SIM_XY_MIN_MG
        int "Simulator X/Y minimum (milli-g)"
        range -2000 2000
        default -250

    config ACCEL_SIM_XY_MAX_MG
        int "Simulator X/Y maximum (milli-g)"
        range -2000 2000
        default 250

    config ACCEL_SIM_Z_MIN_MG
        int "Simulator Z minimum (milli-g)"
        range -2000 2000
        default 750

    config ACCEL_SIM_Z_MAX_MG
        int "Simulator Z maximum (milli-g)"
        range -2000 2000
        default 1250
        help
            OQ-04. Simulated readings are uniform integer milli-g inside
            these ranges (a board lying flat reads about +1 g on Z).

    config ACCEL_PROBE_TASK_STACK
        int "Sensor probe task stack (bytes)"
        default 2560
        help
            REQ-MEM-04. Initial value; resize from the measured STACK_HWM.
            Allocated on the heap once at init (static DRAM headroom is
            small, tech_spec.md 2.9).

    config ACCEL_PROBE_TASK_PRIO
        int "Sensor probe task priority"
        range 1 5
        default 1
        help
            REQ-PERF-05. Lowest priority: probing has no deadline.

endmenu
